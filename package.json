{
  "name": "temple-accounts-7-sqlite",
  "version": "1.0.0",
  "description": "Temple Accounts Version 7 with SQLite database",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.templeaccounts.version7.sqlite",
    "productName": "Temple Accounts Version 7 SQLite",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": ["portable"]
    }
  }
}
